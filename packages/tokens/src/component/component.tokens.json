{
  "$description": "Tokens de componente (camada component): aliam tokens semânticos; resolvem por escopo no CSS.",
  "color": {
    "$type": "color",
    "button": {
      "bg": { "default": { "$value": "{color.bg.accent}" } },
      "fg": { "default": { "$value": "{color.fg.on-accent}" } }
    }
  },
  "size": {
    "$type": "dimension",
    "button": {
      "height": { "md": { "$value": "{size.control.md}" } }
    }
  }
}
