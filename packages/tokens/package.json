{
  "name": "@patods/tokens",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./values": {
      "types": "./dist/esm/values.d.ts",
      "default": "./dist/esm/values.js"
    },
    "./css/base.css": "./dist/css/base.css",
    "./css/brand-*.css": "./dist/css/brand-*.css",
    "./meta/*": "./dist/meta/*"
  },
  "files": [
    "dist/css/base.css",
    "dist/css/brand-*.css",
    "dist/esm/index.js",
    "dist/esm/index.d.ts",
    "dist/esm/values.js",
    "dist/esm/values.d.ts",
    "dist/meta/*.json",
    "dist/meta/report.md",
    "api/tokens.api.json",
    "README.md"
  ],
  "scripts": {
    "tokens:validate": "node ../../tools/tokens-build/src/cli.ts validate",
    "tokens:build": "node ../../tools/tokens-build/src/cli.ts build",
    "contrast:check": "node ../../tools/tokens-contrast/src/cli.ts check --out reports"
  },
  "devDependencies": {
    "@patods/tokens-build": "workspace:*",
    "@patods/tokens-contrast": "workspace:*"
  }
}
