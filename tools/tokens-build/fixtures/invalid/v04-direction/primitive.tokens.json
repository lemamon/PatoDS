{
  "$description": "Primitive layer: the only tokens with a literal value (TOK-02, V-02). Brand and mode invariants (V-07). The first segment is always a category from TOK-10 (V-06).",
  "color": {
    "$type": "color",
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "black": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0627,
          0.0706,
          0.0863
        ],
        "hex": "#101216"
      }
    },
    "neutral": {
      "0": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        }
      },
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9529,
            0.9569,
            0.9647
          ],
          "hex": "#f3f4f6"
        }
      },
      "300": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8196,
            0.8353,
            0.8588
          ],
          "hex": "#d1d5db"
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2941,
            0.3333,
            0.3882
          ],
          "hex": "#4b5563"
        }
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0667,
            0.0941,
            0.1529
          ],
          "hex": "#111827"
        }
      }
    },
    "blue": {
      "300": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5765,
            0.7725,
            0.9922
          ],
          "hex": "#93c5fd"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1451,
            0.3882,
            0.9216
          ],
          "hex": "#2563eb"
        }
      }
    },
    "rogue": {
      "$type": "color",
      "$value": "{color.bg.surface}"
    }
  },
  "space": {
    "0": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "$type": "dimension"
  },
  "size": {
    "$type": "dimension",
    "h": {
      "sm": {
        "$value": {
          "value": 1.75,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 2.75,
          "unit": "rem"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "1": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "2": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  },
  "typography": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      }
    },
    "line-height": {
      "$type": "dimension",
      "md": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "z-index": {
    "$type": "number",
    "layer": {
      "overlay": {
        "$value": 1000
      }
    }
  },
  "opacity": {
    "60": {
      "$value": 0.6
    },
    "$type": "number"
  },
  "breakpoint": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 768,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0.0667,
            0.0941,
            0.1529
          ],
          "alpha": 0.2,
          "hex": "#111827"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
